[Unit]
Description=MAXCOURSE private print agent
After=network.target

[Service]
Type=simple
User=maxcourse-print
Group=maxcourse-print
WorkingDirectory=/opt/maxcourse-print-agent
EnvironmentFile=/etc/maxcourse-print-agent/agent.env
ExecStart=/usr/bin/python3 -m campus_print.agent
Restart=on-failure
RestartSec=5
StateDirectory=maxcourse-print-agent
StateDirectoryMode=0700
RuntimeDirectory=maxcourse-print-agent
RuntimeDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M
TasksMax=64
LimitCORE=0
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
