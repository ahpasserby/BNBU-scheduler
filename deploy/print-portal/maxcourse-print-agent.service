[Unit]
Description=MAXCOURSE private print agent
After=network.target

[Service]
Type=simple
User=maxcourse-print
Group=maxcourse-print
WorkingDirectory=/opt/maxcourse-print-agent
EnvironmentFile=/etc/maxcourse-print-agent/agent.env
ExecStart=/usr/bin/python3 -m campus_print.agent
Restart=on-failure
RestartSec=5
StateDirectory=maxcourse-print-agent
StateDirectoryMode=0700
RuntimeDirectory=maxcourse-print-agent
RuntimeDirectoryMode=0700
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Bubblewrap mounts a private /proc inside its own user/PID namespace.
# Masking the parent /proc prevents that mount on the supported ARM kernel.
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectControlGroups=yes
# This filter returns ENOSYS for openat2, which Bubblewrap 0.12 requires.
# NoNewPrivileges and the unprivileged service account remain enforced.
RestrictSUIDSGID=no
LockPersonality=yes
# LibreOffice conversion needs more headroom than Ghostscript; jobs never overlap.
MemoryMax=800M
TasksMax=256
LimitCORE=0
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
