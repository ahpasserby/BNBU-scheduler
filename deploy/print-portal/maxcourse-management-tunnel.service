[Unit]
Description=MAXCOURSE private device management SSH tunnel
After=network-online.target ssh.service
Wants=network-online.target

[Service]
User=maxcourse-device-tunnel
Group=maxcourse-device-tunnel
EnvironmentFile=/etc/maxcourse-device-tunnel/tunnel.env
ExecStart=/usr/bin/ssh -NT -o BatchMode=yes -o IdentitiesOnly=yes -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=yes -o UpdateHostKeys=no -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ConnectTimeout=10 -o UserKnownHostsFile=/var/lib/maxcourse-device-tunnel/known_hosts -i /var/lib/maxcourse-device-tunnel/tunnel_key -R 127.0.0.1:18766:127.0.0.1:22 ${MANAGEMENT_TUNNEL_USER}@${MANAGEMENT_TUNNEL_HOST}
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
MemoryMax=64M
TasksMax=24

[Install]
WantedBy=multi-user.target
